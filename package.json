{
  "name": "workspace-platform",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "prepare": "husky",
    "db:push": "pnpm --filter @workspace/api db:push",
    "db:generate": "pnpm --filter @workspace/api db:generate",
    "db:studio": "pnpm --filter @workspace/api db:studio",
    "db:init": "tsx packages/api/src/scripts/init-db.ts",
    "docker:up": "docker compose up -d && echo 'Waiting for services...' && sleep 5 && pnpm db:init",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d && sleep 5 && pnpm db:init",
    "dev:full": "pnpm docker:up && pnpm dev",
    "seed": "tsx packages/api/src/scripts/seed.ts",
    "seed:reset": "tsx packages/api/src/scripts/seed-reset.ts"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "tsx": "^4.21.0"
  }
}
