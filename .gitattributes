# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force shell scripts to LF (husky hooks must have LF on Windows)
*.sh text eol=lf
.husky/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
