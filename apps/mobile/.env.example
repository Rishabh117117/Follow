# apps/mobile environment variables (Expo). Copy to `.env` to use.
# Only EXPO_PUBLIC_* values are exposed to the JS bundle at build time.

# Google OAuth client IDs used by expo-auth-session on the auth screen.
# If all three are empty, the auth screen takes a dev-bypass branch that
# signs in as DEV_USER / DEV_WORKSPACE from @workspace/shared — this path
# requires the backend to be running with DEV_BYPASS_AUTH=true.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Overrides expo.extra.apiUrl from app.json when set.
# Default: http://localhost:3001 (the @workspace/api Hono server).
EXPO_PUBLIC_API_URL=
