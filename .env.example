# =============================================================================
# Workspace Platform — Environment Configuration
# =============================================================================
# Copy this file to .env.docker (for Docker setup) or .env.local (for dev)
# Required variables are marked with [REQUIRED]

# ── Database (PostgreSQL with pgvector) ──────────────────────────────
# [REQUIRED for Docker] Connection string for PostgreSQL.
# Without this, the app falls back to PGlite (file-based, dev only).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace_platform

# ── Redis ────────────────────────────────────────────────────────────
# [REQUIRED for Docker] Redis connection URL.
# Without this, the app uses an in-memory Redis-compatible store.
REDIS_URL=redis://localhost:6379

# ── ClickHouse ───────────────────────────────────────────────────────
# [REQUIRED for Docker] ClickHouse HTTP interface URL.
# Without this, the app uses an in-memory ClickHouse-compatible store.
CLICKHOUSE_URL=http://localhost:8123
# ClickHouse database name (created automatically on init)
CLICKHOUSE_DB=workspace_platform
# ClickHouse credentials (default user, no password for dev)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── S3 / MinIO ──────────────────────────────────────────────────────
# [REQUIRED for file uploads] S3-compatible storage credentials.
# For local dev with MinIO, use the values below.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=workspace-platform-files
# Set this for MinIO or other S3-compatible endpoints.
# Omit for real AWS S3.
S3_ENDPOINT=http://localhost:9090

# ── Application ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
WS_PORT=3002

# ── Next.js ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3002
NEXT_PUBLIC_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# [REQUIRED] A random secret for signing session tokens. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-min-32-chars

# ── Dev Mode ─────────────────────────────────────────────────────────
# Set to true to skip authentication (dev only, never in production)
DEV_BYPASS_AUTH=true

# ── AI / LLM ─────────────────────────────────────────────────────────
# [REQUIRED for AI features] OpenRouter API key for LLM calls.
OPENROUTER_API_KEY=sk-or-...

# ── MCP / External Access ───────────────────────────────────────────
# Public URL for the API (used in OpenAPI spec for ChatGPT integration).
# Set this to your ngrok tunnel URL when running with external clients.
MCP_PUBLIC_URL=http://localhost:3001

# ── Threads & Strands ───────────────────────────────────────────────
THREAD_SPEAKER_MODEL=deepseek/deepseek-chat-v3-0324
THREAD_DISTILLATION_MODEL=google/gemini-2.5-flash
CROSS_REF_CONFIDENCE_THRESHOLD=0.85
