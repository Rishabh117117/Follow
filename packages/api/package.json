{
  "name": "@workspace/api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "tsx src/scripts/db-deploy.ts",
    "db:reset": "tsx src/scripts/db-reset.ts",
    "db:baseline-stamp": "tsx src/scripts/db-baseline-stamp.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "smoke": "tsx ../../deploy/smoke.ts",
    "e2e": "tsx ../../deploy/e2e-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.75.0",
    "@aws-sdk/client-s3": "^3.992.0",
    "@aws-sdk/s3-request-presigner": "^3.992.0",
    "@clickhouse/client": "^1.17.0",
    "@electric-sql/pglite": "^0.3.15",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@langchain/langgraph": "^1.3.4",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.2",
    "@workspace/shared": "workspace:*",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.0",
    "jose": "^6.1.3",
    "lib0": "^0.2.117",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "openai": "^6.25.0",
    "pdf-parse-fork": "^1.2.0",
    "postgres": "^3.4.5",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.0",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
